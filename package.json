{
  "name": "dsh-immersion-glow",
  "version": "0.1.0",
  "description": "沉浸觉察：DSH 会话内的时间觉察助手。净活跃时间到阈值时，右上角弹一张提醒卡指向本次会话统计；可收藏为记录卡，零网络。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "immersion",
    "time-awareness",
    "break-reminder",
    "沉浸觉察",
    "久坐提醒"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/img"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node tools/verify-bundle.mjs",
    "check": "npm run build && node --check lib/index.js && node --check lib/client.js && npm test && npm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "author": "baobao1994",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baobao1994/dsh-immersion-glow.git"
  },
  "homepage": "https://github.com/baobao1994/dsh-immersion-glow#readme",
  "bugs": {
    "url": "https://github.com/baobao1994/dsh-immersion-glow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
